{
  "expo": {
    "name": "Wero",
    "slug": "wero",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "wero",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#07080B"
    },
    "assetBundlePatterns": [
      "assets/data/**/*",
      "assets/aud/**/*",
      "assets/img/**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.wero.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Wero usa el micrófono para oír la palabra que dices y decirte cuál entendió. Wero no graba ni guarda el audio.",
        "NSSpeechRecognitionUsageDescription": "El servicio de voz del teléfono entiende la palabra que dijiste para compararla con la que se pidió; puede procesarla en sus servidores. Wero no guarda el audio."
      }
    },
    "android": {
      "package": "app.wero.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#07080B"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/BricolageGrotesque-Bold.ttf",
              "./assets/fonts/BricolageGrotesque-SemiBold.ttf",
              "./assets/fonts/InstrumentSans-Regular.ttf",
              "./assets/fonts/InstrumentSans-SemiBold.ttf",
              "./assets/fonts/CharisSIL-Regular.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "BricolageGrotesque-Bold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/BricolageGrotesque-Bold.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "BricolageGrotesque-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/BricolageGrotesque-SemiBold.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "InstrumentSans-Regular",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/InstrumentSans-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "InstrumentSans-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/InstrumentSans-SemiBold.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "CharisSIL",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/CharisSIL-Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F5BFF"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Wero necesita el micrófono para oírte decir la palabra.",
          "speechRecognitionPermission": "El servicio de voz del teléfono entiende lo que dices y puede procesarlo en sus servidores. Wero no guarda el audio.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-audio",
      "./plugins/withFirmaRelease.js",
      "expo-splash-screen",
      "expo-sqlite",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
